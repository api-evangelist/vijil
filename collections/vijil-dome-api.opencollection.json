                "description": "Time window for aggregation (e.g., '1m', '5m', '15m')"
              },
              {
                "name": "percentiles",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of percentiles to query (e.g., '0.5,0.95'). If not specified, defaults to [0.5, 0.9, 0.95, 0.99]"
              },
              {
                "name": "evaluation_id",
