          "name": "Get Evaluation Results",
          "request": {
            "name": "Get Evaluation Results",
            "description": {
              "content": "Get evaluation results from S3 storage.\n\nThe results are saved to S3 after the evaluation job completes.\nThis endpoint searches S3 directly (no repository dependency).\n\nArgs:\n    evaluation_id: UUID of the evaluation\n    team_id: Team ID that owns this evaluation (required query parameter)\n    claims: JWT claims with user and team info\n    diamond_domain: Diamond domain orchestrator (not used, kept for API consistency)\n    storage: Evaluation storage adapter\n\nReturns:\n    Evaluation results as JSON\n\nRaises:\n    HTTPException: 404 if not found, 403 if no permission",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v1",
                "evaluation-results",
                ":evaluation_id",
                "results"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [
                {
                  "disabled": false,
                  "key": "team_id",
                  "value": "<uuid>",
                  "description": "(Required) Team ID that owns this evaluation"
